
import "Gillian-LLVM/examples/rt/runtime.gil";
proc main() {
  v_f := {{"i-1",0x0v1}};
  v_t := {{"i-1",0x1v1}};

  v_1 := {{"i-32",0x5v32}};
  v_2 := {{"i-32",0x80000000v32}};
  v_3 := {{"i-64",0x5v64}};
  v_4 := {{"i-64",0x8000000000000000v64}};
  v_5 := {{"i-64", 0x1234567890ABCDEFv64}};
  v_6 := {{"i-32", 0x90ABCDEFv32}};
  v_7 := {{"i-8", 0x3v8}};
  v_8 := {{"i-8", 0x2v8}};
  v_9 := {{"i-32",0x6v32}};
  v_10 := {{"i-32",0x1v32}};
  v_11 := {{"i-32",0x0v32}};
  v_12 := {{"i-32",0x7FFFFFFBv32}};
  v_13 := {{"i-32",0x4v32}};
  v_14 := {{"i-32",0x1Ev32}};
  v_15 := {{"i-32",0x7v32}};
  v_16 := {{"i-32",0x3v32}};
  v_17 := {{"i-32",0x8v32}};
  v_18 := {{"i-32",0x2v32}};
  v_19 := {{"i-32",0x40000000v32}};
  v_20 := {{"i-32",0xFFFFFFFAv32}}; (* -6 *)
  v_21 := {{"i-32",0xFFFFFFFEv32}}; (* -2 *)
  v_22 := {{"i-32",0xFFFFFFFDv32}}; (* -3 *)
  v_23 := {{"i-32",0xFFFFFFFFv32}}; (* -1 *)
  v_24 := {{"i-64",0x80000000v64}};
  v_25 := {{"i-64",0xFFFFFFFF80000000v64}};
  v_26 := {{"i-32",0xFFFFFFFBv32}}; (* -5 *)
  v_27 := {{"i-16",0x1234v16}};
  v_28 := {{"i-16",0x3412v16}};
  v_29 := {{"i-32",0x12345678v32}};
  v_30 := {{"i-32",0x78563412v32}};
  v_31 := {{"i-32",0xFFFFFFFFv32}};
  v_32 := {{"i-32",0x90ABCDEFv32}};
  v_33 := {{"i-32",0x34567890v32}};
  v_34 := {{"i-32",0x20v32}};
  v_35 := {{"i-32",0x28v32}};
  v_36 := {{"i-32",0x7890ABCDv32}};
  v_37 := {{"i-8", 0xF0v8}};
  v_38 := {{"i-8", 0x4v8}};
  v_39 := {{"i-32", 0x7FFFFFFFv32}};
  v_40 := {{"i-32", 0x7FFFFFFEv32}};
  v_41 := {{"i-32",0x80000000v32}};
  v_42 := {{"i-33",0x3v33}};
  v_43 := {{"i-33",0xCv33}};
  v_44 := {{"i-32",0x80000001v32}};
  v_45 := {{"i-33",0x2v33}};
  v_46 := {{"i-33",0x1FFFFFFFFv33}};
  v_47 := {{"i-33",0xFFFFFFF6v33}};
  v_48 := {{"i-33",0x10000000Bv33}};
  v_49 := {{"i-33",0x100000002v33}};
  v_50 := {{"i-33",0x100000000v33}};
  v_51 := {{"i-33",0xFFFFFFF2v33}};
  v_52 := {{"i-33",0x1FFFFFFF6v33}};
  v_53 := {{"i-33",0x12v33}};
  v_54 := {{"i-33",0xFFFFFFFCv33}};
  v_55 := {{"i-33",0x0v33}};
  v_56 := {{"i-33",0x1v33}};
  v_57 := {{"i-33",0xDv33}};
  v_58 := {{"i-8",0x0v8}};
  v_59 := {{"i-8",0x8v8}};
  v_60 := {{"i-8",0x3v8}};
  v_61 := {{"i-8",0x6v8}};

  (* Test umin *)
  r_0 := "bvumin_32_32_32"(v_1, v_2);
  assert((r_0 == v_1));
  r_1 := "bvumin_32_32_32"(v_2, v_1);
  assert((r_1 == v_1));
  r_2 := "bvumin_64_64_64"(v_3, v_4);
  assert((r_2 == v_3));
  r_3 := "bvumin_64_64_64"(v_4, v_3);
  assert((r_3 == v_3));
  r_4 := "bvumin_32_32_32"(v_1, v_9);
  assert((r_4 == v_1));
  r_5 := "bvumin_32_32_32"(v_9, v_1);
  assert((r_5 == v_1));

  (* Test trunc *)
  r_6 := "bvtrunc_64_32"(v_5);
  assert((r_6 == v_6));
  r_7 := "bvtrunc_8_1"(v_7);
  assert((r_7 == v_t));
  r_8 := "bvtrunc_8_1"(v_8);
  assert((r_8 == v_f));

  (* Test select *)
  r_9 := "select_1_32_32_32"(v_t, v_1, v_9);
  assert((r_9 == v_1));
  r_10 := "select_1_32_32_32"(v_t, v_9, v_1);
  assert((r_10 == v_9));
  r_11 := "select_1_32_32_32"(v_f, v_1, v_9);
  assert((r_11 == v_9));
  r_12 := "select_1_32_32_32"(v_f, v_9, v_1);
  assert((r_12 == v_1));

  (* Test usubsat *)
  r_13 := "usubsat_32_32_32"(v_9, v_1);
  assert((r_13 == v_10));
  r_14 := "usubsat_32_32_32"(v_1, v_9);
  assert((r_14 == v_11));
  r_15 := "usubsat_32_32_32"(v_2, v_1);
  assert((r_15 == v_12));
  r_16 := "usubsat_32_32_32"(v_1, v_2);
  assert((r_16 == v_11));

  (* Test abs *)
  r_17 := "bvabs_32_32"(v_1);
  assert((r_17 == v_1));
  r_18 := "bvabs_32_32"(v_26);
  assert((r_18 == v_1));

  (* Test mul *)
  r_19 := "bvmul_32_32_32"(v_1, v_9);
  assert((r_19 == v_14));
  r_20 := "bvmul_32_32_32"(v_9, v_1);
  assert((r_20 == v_14));

  (* Test and *)
  r_21 := "bvand_32_32_32"(v_10, v_13);
  assert((r_21 == v_11));
  r_22 := "bvand_32_32_32"(v_13, v_10);
  assert((r_22 == v_11));
  r_23 := "bvand_32_32_32"(v_1, v_13);
  assert((r_23 == v_13));
  r_24 := "bvand_32_32_32"(v_13, v_1);
  assert((r_24 == v_13));

  (* Test or *)
  r_25 := "bvor_32_32_32"(v_9, v_1);
  assert((r_25 == v_15));
  r_26 := "bvor_32_32_32"(v_1, v_9);
  assert((r_26 == v_15));

  (* Test xor *)
  r_27 := "bvxor_32_32_32"(v_9, v_1);
  assert((r_27 == v_16));
  r_28 := "bvxor_32_32_32"(v_1, v_9);
  assert((r_28 == v_16));

  (* Test shl *)
  r_29 := "bvshl_32_32_32"(v_10, v_16);
  assert((r_29 == v_17));
  r_30 := "bvshl_32_32_32"(v_2, v_10);
  assert((r_30 == v_11));

  (* Test lshr *)
  r_31 := "bvlshr_32_32_32"(v_1, v_18);
  assert((r_31 == v_10));
  r_32 := "bvlshr_32_32_32"(v_2, v_10);
  assert((r_32 == v_19));

  (* Test sdiv *)
  r_33 := "bvsdiv_32_32_32"(v_9, v_16);
  assert((r_33 == v_18));
  r_34 := "bvsdiv_32_32_32"(v_20, v_16);
  assert((r_34 == v_21));

  (* Test srem *)
  r_35 := "bvsrem_32_32_32"(v_9, v_16);
  assert((r_35 == v_11));
  r_36 := "bvsrem_32_32_32"(v_15, v_16);
  assert((r_36 == v_10));
  r_37 := "bvsrem_32_32_32"(v_26, v_16);
  assert((r_37 == v_21));

  (* Test add *)
  r_38 := "bvadd_32_32_32"(v_16, v_18);
  assert((r_38 == v_1));
  r_39 := "bvadd_32_32_32"(v_18, v_16);
  assert((r_39 == v_1));
  r_40 := "bvadd_32_32_32"(v_21, v_22);
  assert((r_40 == v_26));
  r_41 := "bvadd_32_32_32"(v_22, v_21);
  assert((r_40 == v_26));

  (* Test sub *)
  r_42 := "bvsub_32_32_32"(v_16, v_18);
  assert((r_42 == v_10));
  r_43 := "bvsub_32_32_32"(v_18, v_16);
  assert((r_43 == v_23));
  r_44 := "bvsub_32_32_32"(v_21, v_22);
  assert((r_44 == v_10));
  r_45 := "bvsub_32_32_32"(v_22, v_21);
  assert((r_45 == v_23));

  (* Test zext *)
  r_46 := "bvzext_32_64"(v_1);
  assert((r_46 == v_3));
  r_47 := "bvzext_32_64"(v_2);
  assert((r_47 == v_24));

  (* Test sext *)
  r_48 := "bvsext_32_64"(v_1);
  assert((r_48 == v_3));
  r_49 := "bvsext_32_64"(v_2);
  assert((r_49 == v_25));

  (* Test ashr *)
  r_50 := "bvashr_32_32_32"(v_1, v_18);
  assert((r_50 == v_10));
  r_51 := "bvashr_32_32_32"(v_20, v_10);
  assert((r_51 == v_22));

  (* Test bswap *)
  r_52 := "bswap_16_16"(v_27);
  assert((r_52 == v_28));
  r_53 := "bswap_32_32"(v_29);
  assert((r_53 == v_30));

  (* Test umax *)
  r_54 := "bvumax_32_32_32"(v_1, v_2);
  assert((r_54 == v_2));
  r_55 := "bvumax_32_32_32"(v_2, v_1);
  assert((r_55 == v_2));
  r_56 := "bvumax_64_64_64"(v_3, v_4);
  assert((r_56 == v_4));
  r_57 := "bvumax_64_64_64"(v_4, v_3);
  assert((r_57 == v_4));
  r_58 := "bvumax_32_32_32"(v_1, v_9);
  assert((r_58 == v_9));
  r_59 := "bvumax_32_32_32"(v_9, v_1);
  assert((r_59 == v_9));

  (* Test smin *)
  r_60 := "bvsmin_32_32_32"(v_1, v_23);
  assert((r_60 == v_23));
  r_61 := "bvsmin_32_32_32"(v_1, v_9);
  assert((r_61 == v_1));
  r_62 := "bvsmin_32_32_32"(v_20, v_21);
  assert((r_62 == v_20));

  (* Test smax *)
  r_63 := "bvsmax_32_32_32"(v_1, v_23);
  assert((r_63 == v_1));
  r_64 := "bvsmax_32_32_32"(v_1, v_9);
  assert((r_64 == v_9));
  r_65 := "bvsmax_32_32_32"(v_20, v_21);
  assert((r_65 == v_21));

  (* Test uaddsat *)
  r_66 := "uaddsat_32_32_32"(v_2, v_2);
  assert((r_66 == v_31));
  r_67 := "uaddsat_32_32_32"(v_1, v_10);
  assert((r_67 == v_9));

  (* Test bvfshl *)
  r_68 := "bvfshl_32_32_32_32"(v_29, v_32, v_17);
  assert((r_68 == v_33));
  r_69 := "bvfshl_32_32_32_32"(v_29, v_32, v_34);
  assert((r_69 == v_29));
  r_70 := "bvfshl_32_32_32_32"(v_29, v_32, v_35);
  assert((r_70 == v_33));

  (* Test bvfshr *)
  r_71 := "bvfshr_32_32_32_32"(v_29, v_32, v_17);
  assert((r_71 == v_36));
  r_72 := "bvfshr_32_32_32_32"(v_29, v_32, v_34);
  assert((r_72 == v_32));
  r_73 := "bvfshr_32_32_32_32"(v_29, v_32, v_35);
  assert((r_73 == v_36));

  (* Test ctpop *)
  r_74 := "ctpop_8_8"(v_7);
  assert((r_74 == v_8));
  r_75 := "ctpop_8_8"(v_37);
  assert((r_75 == v_38));

  (* Test saddsat *)
  r_76 := "saddsat_32_32_32"(v_10, v_39);
  assert((r_76 == v_39));
  r_77 := "saddsat_32_32_32"(v_39, v_10);
  assert((r_77 == v_39));
  r_78 := "saddsat_32_32_32"(v_40, v_10);
  assert((r_78 == v_39));
  r_79 := "saddsat_32_32_32"(v_40, v_11);
  assert((r_79 == v_40));
  r_80 := "saddsat_32_32_32"(v_41, v_23);
  assert((r_80 == v_41));
  r_81 := "saddsat_32_32_32"(v_23, v_41);
  assert((r_81 == v_41));

  (* Test saddsat *)
  r_82 := "ssubsat_32_32_32"(v_2, v_10);
  assert((r_82 == v_2));
  r_83 := "ssubsat_32_32_32"(v_2, v_11);
  assert((r_83 == v_2));
  r_84 := "ssubsat_32_32_32"(v_20, v_39);
  assert((r_84 == v_2));
  r_85 := "ssubsat_32_32_32"(v_22, v_21);
  assert((r_85 == v_23));
  r_86 := "ssubsat_32_32_32"(v_9, v_16);
  assert((r_86 == v_16));
  r_87 := "ssubsat_32_32_32"(v_11, v_2);
  assert((r_87 == v_39));
  r_88 := "ssubsat_32_32_32"(v_39, v_23);
  assert((r_88 == v_39));

  (* Test uadd_overflow *)
  r_89 := "uadd_overflow_32_32_33"(v_2, v_44);
  assert((r_89 == v_42));
  r_90 := "uadd_overflow_32_32_33"(v_1, v_10);
  assert((r_90 == v_43));

  (* Test usub_overflow *)
  r_91 := "usub_overflow_32_32_33"(v_9, v_1);
  assert((r_91 == v_45));
  r_92 := "usub_overflow_32_32_33"(v_1, v_9);
  assert((r_92 == v_46));
  r_93 := "usub_overflow_32_32_33"(v_2, v_1);
  assert((r_93 == v_47));
  r_94 := "usub_overflow_32_32_33"(v_1, v_2);
  assert((r_94 == v_48));

  (* Test sadd_overflow *)
  r_95 := "sadd_overflow_32_32_33"(v_2, v_10);
  assert((r_95 == v_49));
  r_96 := "sadd_overflow_32_32_33"(v_2, v_11);
  assert((r_96 == v_50));
  r_97 := "sadd_overflow_32_32_33"(v_20, v_39);
  assert((r_97 == v_51));
  r_98 := "sadd_overflow_32_32_33"(v_22, v_21);
  assert((r_98 == v_52));
  r_99 := "sadd_overflow_32_32_33"(v_9, v_16);
  assert((r_99 == v_53));
  r_100 := "sadd_overflow_32_32_33"(v_11, v_2);
  assert((r_100 == v_50));
  r_101 := "sadd_overflow_32_32_33"(v_39, v_23);
  assert((r_101 == v_54));

  (* Test umul_overflow *)
  r_102 := "umul_overflow_32_32_33"(v_15, v_11);
  assert((r_102 == v_55));
  r_103 := "umul_overflow_32_32_33"(v_2, v_18);
  assert((r_103 == v_56));
  r_104 := "umul_overflow_32_32_33"(v_18, v_2);
  assert((r_104 == v_56));
  r_105 := "umul_overflow_32_32_33"(v_16, v_16);
  assert((r_105 == v_53));
  r_106 := "umul_overflow_32_32_33"(v_21, v_22);
  assert((r_106 == v_57));

  (* Test smul_overflow *)
  r_107 := "smul_overflow_32_32_33"(v_15, v_11);
  assert((r_107 == v_55));
  r_108 := "smul_overflow_32_32_33"(v_11, v_15);
  assert((r_108 == v_55));
  r_109 := "smul_overflow_32_32_33"(v_2, v_18);
  assert((r_109 == v_56));
  r_110 := "smul_overflow_32_32_33"(v_16, v_16);
  assert((r_110 == v_53));
  r_111 := "smul_overflow_32_32_33"(v_21, v_22);
  assert((r_111 == v_43));

  (* Test cttz *)
  r_112 := "cttz_8_1_8"(v_7, v_f);
  assert((r_112 == v_58));
  r_113 := "cttz_8_1_8"(v_37, v_f);
  assert((r_113 == v_38));
  r_114 := "cttz_8_1_8"(v_58, v_f);
  assert((r_114 == v_59));
  r_115 := "cttz_8_1_8"(v_59, v_f);
  assert((r_115 == v_60));

  (* Test ctlz *)
  r_116 := "ctlz_8_1_8"(v_7, v_f);
  assert((r_116 == v_61));
  r_117 := "ctlz_8_1_8"(v_37, v_f);
  assert((r_117 == v_58));
  r_118 := "ctlz_8_1_8"(v_58, v_f);
  assert((r_118 == v_59));
  r_119 := "ctlz_8_1_8"(v_59, v_f);
  assert((r_119 == v_38));

  ret := {{}};
  return
};
